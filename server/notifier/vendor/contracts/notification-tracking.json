  "catchUp": {
    "source": "session.events.since",
    "watermarkField": "last_seen",
    "resultFields": [
      "events",
      "latest_seq",
      "truncated",
      "epoch"
    ],
    "store": "/data/cursor",
    "scope": [
      "connection",
      "profile",
      "sessionId"
    ],
    "onRestart": "replay-from-last_seen",
    "onTruncated": "refetch-session-history",
    "onEpochChange": "reset-and-refetch",
    "maxReplayEvents": 1000,
    "onMaxReplayEvents": "continue-from-last-processed",
    "note": "Un redémarrage ne perd aucun terminal : le curseur reprend après last_seen et un historique tronqué est rechargé avant de notifier. Au-delà de maxReplayEvents, le rejeu reprend depuis le dernier événement traité."
  },
  "retention": {
    "notifiedTtlSeconds": 604800,
    "expiredTtlSeconds": 86400,
    "deduplicationTtlSeconds": 2592000,
    "outboxMaxAgeSeconds": 172800,
    "cursor": "while-session-exists",
    "pruneIntervalSeconds": 3600,
    "onPrune": "delete-and-count",
    "note": "Les abonnements notifiés, expirés ou révoqués, la déduplication et l'outbox sont purgés ; aucune entrée ne reste indéfiniment dans /data."
  },
  "health": {
    "path": "/v1/health",
    "auth": "bearer",
    "states": [
      "ok",
      "degraded"
    ],
    "degradedWhen": [
      {
        "reason": "hermes-unreachable",
        "probe": "last-success-age",
        "thresholdSeconds": 60
      },
      {
        "reason": "outbox-backlog",
        "probe": "outboxPending",
        "threshold": 50
      },
      {
        "reason": "fcm-unavailable",
        "probe": "last-fcm-error-age",
        "thresholdSeconds": 300,
        "exceptEnvironment": "integration"
      },
      {
        "reason": "storage-error",
        "probe": "last-storage-error-age",
        "thresholdSeconds": 0
      }
    ],
    "responseFields": [
      "state",
      "reasons",
      "counters",
      "version",
      "checkedAt"
    ],
    "counters": [
      "pending",
      "attached",
      "outboxPending",
      "delivered",
      "failed",
      "dropped",
      "expired",
      "revoked",
      "invalidToken"
    ],
    "forbiddenContent": true,
    "forbiddenFields": [
      "subscriptionId",
      "executionId",
      "sessionId",
      "profile",
      "text",
      "message",
      "path",
      "token",
      "fcmToken",
      "credential"
    ],
    "versionFormat": "semver",
    "checkedAtFormat": "RFC3339",
    "note": "La santé ne renvoie jamais de contenu ni d'identifiant de suivi ; sans bearer, réponse 401."
  },
  "invariants": [
    "Un terminal notifiable vient uniquement de contracts/event-mapping.json.",
    "Le mobile enregistre subscriptionId et fcmToken avant prompt.submit ; l'échec n'empêche jamais l'envoi.",
    "Le rattachement envoie sessionId, profile et executionId ; sans session ou sans user_row_id, aucune notification.",
    "La déduplication est (subscriptionId, executionId, terminal) ; le premier terminal notifié gagne et les terminaux tardifs sont ignorés.",
    "La livraison est au moins une fois tant que l'entrée reste dans l'outbox ; après dropAfterSeconds, l'abandon est compté et journalisé.",
    "Le rattrapage reprend depuis last_seen ; truncated ou un changement d'epoch impose un refetch de l'historique.",
    "La rétention borne /data ; aucune entrée attachée ou notifiée ne reste indéfiniment.",
    "Le bloc data ne porte que subscriptionId et outcome ; la notification ne porte qu'un libellé générique dérivé de l'issue.",
    "Le bloc data ne contient aucun texte, chemin, secret ni identité Hermes.",
    "Les erreurs et journaux ne contiennent ni contenu, ni identifiant de suivi, ni token.",
    "La santé exige le bearer et ne renvoie qu'un état borné, des raisons avec seuils et des compteurs.",
    "L'observateur n'écoute pas sur un port hôte publié ; l'accès passe par le tailnet.",
    "Aucun secret ni chemin personnel n'est versionné."
  ]
}
