  "auth": {
    "scheme": "bearer",
    "header": "Authorization",
    "credentialKind": "opaque",
    "perEnvironment": true,
    "entropyBits": 256,
    "mobileStorage": "flutter_secure_storage",
    "serverStorage": "hash-only",
    "hash": "sha-256",
    "salt": "per-credential",
    "comparison": "constant-time",
    "transport": "https",
    "requiredFor": [
      "register",
      "attach",
      "revoke",
      "health"
    ],
    "unauthenticatedResponse": 401,
    "queryStringAllowed": false,
