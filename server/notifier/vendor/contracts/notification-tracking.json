    },
    "observer": {
      "maxAttempts": 5,
      "backoffMs": [
        1000,
        5000,
        30000,
        300000
      ],
      "perTerminal": true,
      "sweepIntervalSeconds": 300,
      "afterMaxAttempts": "keep-in-outbox",
