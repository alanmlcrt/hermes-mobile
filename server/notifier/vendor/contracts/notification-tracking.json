    "android": {
      "channelId": "hermes_turn_complete",
      "channelCreatedBy": "5.3",
      "priority": "high",
      "notificationPriority": "high",
      "defaultSound": true,
      "ttlSeconds": 86400,
      "notificationTagTemplate": "hermes:{subscriptionId}:{outcome}",
      "collapseKeyTemplate": "hermes:{subscriptionId}",
      "visibleDuplicates": "dedupe-by-tag"
