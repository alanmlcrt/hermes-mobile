  "mapping": {
    "path": "contracts/event-mapping.json",
    "authoritative": true,
    "fallback": "unknown",
    "terminalRule": "effect=terminal et terminal=true ; pour message.complete, statusMap fournit l'issue ; pour error, workState fournit failed ; un statut absent ou inconnu ne notifie jamais.",
    "fixturesDir": "contracts/fixtures/"
  },
  "terminals": [
    {
      "outcome": "succeeded",
      "sources": [
        {
          "event": "message.complete",
          "status": "complete"
        }
      ],
      "fixture": "contracts/fixtures/message-complete.json",
      "description": "Le tour s'est terminé avec le statut serveur complete."
    },
    {
      "outcome": "failed",
      "sources": [
        {
          "event": "message.complete",
          "status": "error"
        },
        {
          "event": "error",
          "status": null
        }
      ],
      "correlation": {
        "message.complete/error": "executionId recalculé depuis event.params.session_id et payload.persisted_turn.user_row_id",
        "error": "erreur de session rattachée à l'unique exécution attachée et non notifiée de cette session",
        "rule": "Un error n'est notifié que si une seule exécution est attachée et non notifiée pour la session ; sinon il est ignoré. Un message.complete/error sans persisted_turn.user_row_id est ignoré."
      },
      "fixture": "contracts/fixtures/error.json",
      "description": "Échec de tour ou erreur de session ; les deux passent par failed dans la table partagée."
    },
    {
      "outcome": "stopped",
      "sources": [
        {
          "event": "message.complete",
          "status": "interrupted"
        }
      ],
      "fixture": "contracts/fixtures/message-complete-interrupted.json",
      "description": "Arrêt confirmé par le terminal serveur interrupted."
    }
  ],
  "nonTerminals": {
    "rule": "Tout ce qui n'est pas un terminal de la table partagée reste non notifiable.",
    "examples": [
      "message.start",
      "message.delta",
      "message.interim",
      "tool.start",
      "tool.complete",
      "gateway.ready",
      "status.update",
      "session.info",
      "sessions.changed",
      "session.title",
      "unknown"
    ],
    "unknownStatus": "message.complete avec status absent ou inconnu reste WorkState.unknown et ne notifie jamais."
  },
  "registry": {
    "key": "subscriptionId",
    "generatedBy": "mobile",
    "format": "opaque",
    "encoding": "base64url",
    "minLength": 22,
    "maxLength": 128,
    "minEntropyBits": 122,
    "createdBefore": "prompt.submit",
    "nonBlocking": true,
    "states": [
      "registered",
      "attached",
      "notified",
      "revoked",
      "expired"
    ],
    "lifecycle": [
      {
        "state": "registered",
        "when": "before-prompt-submit",
        "requires": [
          "subscriptionId",
          "fcmToken"
        ],
        "onFailure": "send-proceeds-unfollowed"
      },
      {
        "state": "attached",
        "when": "after-prompt-submit-accepted",
        "requires": [
          "sessionId",
          "profile",
          "executionId"
        ],
        "onFailure": "send-proceeds-unfollowed"
      },
      {
        "state": "notified",
        "when": "terminal-delivered",
        "requires": [
          "executionId",
          "terminal"
        ],
        "onFailure": "outbox-keeps-entry"
      },
      {
        "state": "revoked",
        "when": "client-request",
        "requires": [],
        "onFailure": "retry-bounded"
      },
      {
        "state": "expired",
        "when": "ttl-elapsed-without-terminal",
        "requires": [],
        "onFailure": "no-notification"
      }
    ],
    "attachment": {
      "endpoint": "attach",
      "sessionScope": [
        "sessionId",
        "profile"
      ],
      "sessionIdSource": "prompt.submit.params.session_id",
      "profileSource": "connection.profile",
      "profileNullable": true,
      "observerWatch": [
        "session.resume",
        "session.events.since"
      ],
      "onSessionNotFound": "retry-bounded-then-expire",
      "onExpired": "no-notification"
    },
    "executionId": {
      "definition": "Identité opaque d'une exécution, composée par le mobile au moment de l'attache.",
      "attachTime": {
        "source": "prompt.submit.result.user_row_id",
        "schema": "contracts/openrpc.json#/components/schemas/PromptSubmitResult/properties/user_row_id",
        "scopedBy": "session_id",
        "composition": "base64url(session_id + ':' + user_row_id)",
        "whenMissing": "no-attach-no-notification"
      },
      "terminalMatch": {
        "session": "event.params.session_id",
        "row": "message.complete.payload.persisted_turn.user_row_id",
        "optionalStronger": "message.complete.payload.persisted_turn.submission_id",
        "rule": "L'observateur recalcule executionId depuis session_id et persisted_turn.user_row_id ; si user_row_id manque, aucun rattachement. submission_id peut enrichir la déduplication mais ne remplace jamais user_row_id."
      },
      "sentToObserverOnAttach": true,
      "inPushPayload": false,
      "oldTerminalPolicy": "Un terminal antérieur à l'exécution attachée n'est jamais notifié."
    },
    "deviceToken": {
      "provider": "fcm",
      "registeredWith": "register",
      "rotation": "re-register-same-subscription",
      "storage": "encrypted-at-rest",
      "onePerSubscription": true,
      "requiredForEnvironments": [
        "personal"
      ],
      "dryRunValue": "synthetic-placeholder",
      "inPushPayload": false,
      "inLogs": false,
      "invalidToken": "remove-subscription-no-retry"
    },
    "ttlSeconds": 86400,
    "attachedTtlSeconds": 604800,
    "expiryByState": {
      "registered": "ttlSeconds",
      "attached": "attachedTtlSeconds",
      "notified": "retention.notifiedTtlSeconds",
      "revoked": "delete-on-revoke"
    },
    "revokeOnTerminal": false
  },
  "deduplication": {
    "key": [
      "subscriptionId",
      "executionId",
      "terminal"
    ],
    "terminalValues": [
      "succeeded",
      "failed",
      "stopped"
    ],
    "scope": "observer-outbox",
    "persistent": true,
    "duplicatePolicy": "keep-first",
    "perExecutionPolicy": "first-terminal-wins",
    "lateTerminalPolicy": "ignore-after-notified",
    "providerDuplicatePolicy": "dedupe-visible-by-tag",
    "repeatDelivery": "at-least-once-until-drop",
    "exactlyOnce": false,
    "evidence": "Une nouvelle livraison du même terminal ne crée pas de seconde entrée ; le premier terminal notifié gagne et les suivants sont ignorés. La relance est bornée par dropAfterSeconds, puis l'abandon est compté. Le fournisseur peut encore livrer deux fois, donc aucune promesse exactement une fois."
  },
  "payload": {
    "transport": "fcm-http-v1",
    "platforms": [
